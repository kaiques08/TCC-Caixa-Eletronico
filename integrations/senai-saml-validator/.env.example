NODE_ENV=development
PORT=4100
TRUST_PROXY=1

# Dados do Service Provider aprovados/cadastrados pelo SENAI.
SAML_SP_ENTITY_ID=https://auth.seudominio.com/saml/metadata
SAML_ACS_URL=https://auth.seudominio.com/auth/senai/callback
FINUP_CALLBACK_URL=https://finup.seudominio.com/api/auth/senai/callback
SENAI_SP_APPROVED=false
SENAI_ACS_APPROVED=false

# Metadata oficial do IdP. Prefira o arquivo entregue pelo SENAI.
SENAI_IDP_METADATA_FILE=config/senai-idp-metadata.xml
SENAI_IDP_METADATA_URL=
SENAI_METADATA_ALLOWED_HOSTS=identidade.senai.br,hml.identidade.senai.br

# Assinatura opcional da AuthnRequest pelo SP, se exigida pelo SENAI.
SAML_SP_PRIVATE_KEY_FILE=
SAML_SP_PUBLIC_CERT_FILE=

# Atributos liberados formalmente pelo SENAI.
SAML_ATTR_UNIQUE_ID=
SAML_ATTR_NAME=
SAML_ATTR_EMAIL=
SAML_ATTR_ROLE=
SAML_ATTR_REGISTRATION=
SAML_ATTR_CPF=
SENAI_ATTRIBUTES_APPROVED=false

# Gere valores aleatórios longos e diferentes. Nunca versionar os valores reais.
SAML_SESSION_SECRET=
SAML_BRIDGE_TOKEN=
SAML_SESSION_MAX_AGE_SECONDS=3600
SAML_SESSION_DIR=.data/sessions
SAML_REQUEST_CACHE_DIR=.data/request-cache
SAML_BRIDGE_SESSION_DIR=.data/bridge-sessions

# Parâmetros de validação. Os limites abaixo são conservadores.
SAML_CLOCK_SKEW_MS=60000
SAML_MAX_ASSERTION_AGE_MS=300000
SAML_REQUEST_ID_EXPIRATION_MS=600000
SAML_WANT_ASSERTIONS_SIGNED=true
SAML_WANT_AUTHN_RESPONSE_SIGNED=true
SAML_SIGNATURE_ALGORITHM=sha256
SAML_DIGEST_ALGORITHM=sha256
