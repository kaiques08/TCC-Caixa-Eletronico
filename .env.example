# Configuração do conector institucional. Não inclua credenciais reais no repositório.
SENAI_API_BASE_URL=
SENAI_API_REGISTRO_PATH=
SENAI_API_TOKEN=
SENAI_API_AUTH_SCHEME=Bearer
SENAI_API_AUTH_HEADER=Authorization

# Login federado. Valores fornecidos após o cadastro da aplicação pelo SENAI.
# SENAI_SSO_START_URL deve apontar para o início oficial/aprovado do fluxo SAML.
SENAI_SSO_START_URL=
SENAI_SSO_ALLOWED_HOSTS=identidade.senai.br,hml.identidade.senai.br
SENAI_SAML_ENTITY_ID=
SENAI_SAML_ACS_URL=
SENAI_SSO_LOGOUT_URL=
SENAI_SAML_VALIDATOR_URL=
SENAI_SAML_STATUS_URL=
SENAI_SAML_SESSION_URL=
SENAI_SAML_LOGOUT_URL=
SENAI_SAML_VALIDATOR_TOKEN=

# Os nomes abaixo são aceitos como aliases do protótipo anexado.
SENAI_ENTRY_POINT=
SENAI_ISSUER=
SENAI_CALLBACK_URL=

# Ponte ngrok opcional. Mantenha a chave somente no ambiente do servidor.
NGROK_API_KEY=
NGROK_ENDPOINT_ID=
# E-mails autenticados autorizados, separados por vírgula.
NGROK_ALLOWED_EMAILS=
